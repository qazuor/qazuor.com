---
/**
 * PersonJsonLd Component
 *
 * Renders `Person` structured data for a real person (operator, founder,
 * recruiter-targeted page). Distinct from the `Organization` /
 * `ProfessionalService` schema used on commercial surfaces.
 *
 * Used by:
 * - `/hire` (operator profile for recruiters)
 * - `/about` (extended bio context)
 *
 * Combines with a `BreadcrumbList` schema so the page is grounded in the
 * site hierarchy.
 *
 * @example
 * <PersonJsonLd
 *   lang="en"
 *   name="Leandro Asrilevich"
 *   jobTitle="Senior full-stack engineer"
 *   description="Boutique senior practice..."
 *   url="https://qazuor.com/en/hire"
 *   sameAs={["https://linkedin.com/in/qazuor", "https://github.com/qazuor"]}
 *   knowsAbout={["React", "TypeScript", "Astro", "Performance"]}
 *   breadcrumbs={[{ name: "Home", url: "/" }, { name: "Hire", url: "/hire" }]}
 * />
 */
import type { BreadcrumbListSchema, PersonSchema } from '@/types/jsonld';
import JsonLd from './JsonLd.astro';

interface BreadcrumbItem {
    name: string;
    url?: string;
}

interface Props {
    lang: string;
    name: string;
    jobTitle: string;
    description: string;
    url: string;
    image?: string;
    email?: string;
    sameAs?: string[];
    knowsAbout?: string[];
    breadcrumbs?: BreadcrumbItem[];
}

const {
    lang,
    name,
    jobTitle,
    description,
    url,
    image,
    email,
    sameAs = [],
    knowsAbout = [],
    breadcrumbs = []
} = Astro.props;

const SITE_URL = 'https://qazuor.com';

const personSchema: PersonSchema = {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name,
    jobTitle,
    description,
    url,
    ...(image && { image }),
    ...(email && { email }),
    ...(sameAs.length > 0 && { sameAs }),
    ...(knowsAbout.length > 0 && { knowsAbout })
};

const breadcrumbSchema: BreadcrumbListSchema | null =
    breadcrumbs.length > 0
        ? {
              '@context': 'https://schema.org',
              '@type': 'BreadcrumbList',
              itemListElement: breadcrumbs.map((item, index) => ({
                  '@type': 'ListItem',
                  position: index + 1,
                  name: item.name,
                  ...(item.url && { item: `${SITE_URL}/${lang}${item.url}` })
              }))
          }
        : null;

const schemas = [personSchema, ...(breadcrumbSchema ? [breadcrumbSchema] : [])];
---

<JsonLd schema={schemas} />
