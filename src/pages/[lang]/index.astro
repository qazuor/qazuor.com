    fiverr: t('aria.fiverr'),
    upwork: t('aria.upwork'),
    whatsapp: t('aria.whatsapp'),
    mail: t('aria.mail'),
    buymeacoffee: t('aria.buymeacoffee'),
    discord: t('aria.discord'),
    x: t('aria.x')
};

// Profile translations
const profileTranslations = {
