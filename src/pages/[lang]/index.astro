    // description removed from homepage - kept in dedicated FAQs page
    clientsHeading: t('faqs.clientsHeading', { markdown: true }),
    employersHeading: t('faqs.employersHeading', { markdown: true }),
    faqs: {
        // Only 4 client FAQs on homepage (last one removed - "¿Ofrecés soporte después del lanzamiento?")
