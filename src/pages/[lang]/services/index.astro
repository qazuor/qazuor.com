---
import ComparisonSection from '@/components/sections/ComparisonSection.astro';
import FreelancerVsAgencySection from '@/components/sections/FreelancerVsAgencySection.astro';
import ProcessSection from '@/components/sections/ProcessSection.astro';
import AnimatedGradientBackground from '@/components/ui/AnimatedGradientBackground.astro';
import SectionTitle from '@/components/ui/SectionTitle.astro';
import ServiceIcon from '@/components/ui/ServiceIcon.astro';
import UnifiedButton from '@/components/ui/UnifiedButton.astro';
import { sectionsColors } from '@/data';
import { type Service, type ServiceGrouping, serviceGroupings, services } from '@/data/services';
import { languages } from '@/i18n/ui';
import { getLangFromUrl, getTranslations } from '@/i18n/utils';
import BaseLayout from '@/layouts/BaseLayout.astro';

export function getStaticPaths() {
    return Object.keys(languages).map((lang) => ({
        params: { lang }
    }));
}

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);

// SEO — Qazuor commercial-first framing
const pageTitle = t('services.allServices', { markdown: false });
const pageDescription = t('services.subtitle', { markdown: false });

// Lookup table: service id → translation copy (title + short blurb only —
// the hub reframes services by outcome, so we keep the cards lean).
const serviceKeyMap: Record<string, string> = {
    'web-apps': 'webApps',
    'landing-pages': 'landingPages',
    'automation-integration': 'automation',
    'social-media-design': 'socialDesign',
    'web-optimization': 'webOptimization',
    wordpress: 'wordpress'
};

const serviceBlurbs: Record<string, { title: string; blurb: string }> = Object.fromEntries(
    services.map((service: Service) => {
        const key = serviceKeyMap[service.id];
        return [
            service.id,
            {
                title: t(`services.${key}.title`, { markdown: true }),
                blurb: t(`services.${key}.description`)
            }
        ];
    })
);

// Resolve groupings: for each grouping, replace the `serviceIds` with the
// matching `Service` objects so the template does not have to do its own
// lookups.
const resolvedGroupings = serviceGroupings.map((grouping: ServiceGrouping) => ({
    ...grouping,
    headline: t(grouping.headlineKey, { markdown: false }),
    fit: t(grouping.fitKey, { markdown: false }),
    services: grouping.serviceIds.map((id) => services.find((s) => s.id === id)).filter((s): s is Service => Boolean(s))
}));

// CTA copy (used by the not-sure card and the bottom CTA block)
const ctaTranslations = {
    title: t('services.cta.title', { markdown: true }),
    description: t('services.cta.description', { markdown: true }),
    button: t('services.cta.button', { markdown: true }),
    consultation: t('services.cta.consultation', { markdown: true })
};

// Not-sure card (decoupled from the bottom CTA so it lives inside the hero
// framing as part of the hub intent: "pick the outcome you are after").
const notSureTranslations = {
    eyebrow: t('servicesHub.notSure.eyebrow'),
    title: t('servicesHub.notSure.title'),
    body: t('servicesHub.notSure.body'),
    cta: t('servicesHub.notSure.cta')
};

// Comparison Section Translations
const comparisonTranslations = {
    title: t('services.comparison.title', { markdown: true }),
    subtitle: t('services.comparison.subtitle', { markdown: true }),
    headers: {
        feature: t('services.comparison.headers.feature'),
        webApps: t('services.comparison.headers.webApps'),
        landingPages: t('services.comparison.headers.landingPages'),
        automation: t('services.comparison.headers.automation'),
        socialDesign: t('services.comparison.headers.socialDesign'),
        webOptimization: t('services.comparison.headers.webOptimization'),
        wordpress: t('services.comparison.headers.wordpress')
    },
    labels: {
        timeline: t('services.comparison.labels.timeline'),
        priceRange: t('services.comparison.labels.priceRange'),
        maintenance: t('services.comparison.labels.maintenance'),
        complexity: t('services.comparison.labels.complexity'),
        bestFor: t('services.comparison.labels.bestFor'),
        weeks: t('services.comparison.labels.weeks'),
        consultation: t('services.comparison.labels.consultation'),
        from: t('services.comparison.labels.from')
    },
    maintenance: {
        recommended: t('services.comparison.maintenance.recommended'),
        optional: t('services.comparison.maintenance.optional'),
        'not-needed': t('services.comparison.maintenance.not-needed')
    },
    complexity: {
        low: t('services.comparison.complexity.low'),
        'low-medium': t('services.comparison.complexity.low-medium'),
        medium: t('services.comparison.complexity.medium'),
        'medium-high': t('services.comparison.complexity.medium-high'),
        high: t('services.comparison.complexity.high'),
        'low-high': t('services.comparison.complexity.low-high')
    },
    bestFor: {
        customSolutions: t('services.comparison.bestFor.customSolutions'),
        marketingSeo: t('services.comparison.bestFor.marketingSeo'),
        efficiency: t('services.comparison.bestFor.efficiency'),
        brandPresence: t('services.comparison.bestFor.brandPresence'),
        seoPerformance: t('services.comparison.bestFor.seoPerformance'),
        blogsEcommerce: t('services.comparison.bestFor.blogsEcommerce')
    },
    cta: {
        notSure: t('services.comparison.cta.notSure'),
        contact: t('services.comparison.cta.contact')
    }
};

// Process Section Translations
const processTranslations = {
    title: t('services.process.title', { markdown: true }),
    subtitle: t('services.process.subtitle', { markdown: true }),
    steps: {
        discovery: {
            title: t('services.process.steps.discovery.title'),
            description: t('services.process.steps.discovery.description')
        },
        planning: {
            title: t('services.process.steps.planning.title'),
            description: t('services.process.steps.planning.description')
        },
        design: {
            title: t('services.process.steps.design.title'),
            description: t('services.process.steps.design.description')
        },
        development: {
            title: t('services.process.steps.development.title'),
            description: t('services.process.steps.development.description')
        },
        testing: {
            title: t('services.process.steps.testing.title'),
            description: t('services.process.steps.testing.description')
        },
        launch: {
            title: t('services.process.steps.launch.title'),
            description: t('services.process.steps.launch.description')
        }
    }
};

// Freelancer vs Agency Section Translations
const freelancerVsAgencyTranslations = {
    title: t('services.freelancerVsAgency.title', { markdown: true }),
    subtitle: t('services.freelancerVsAgency.subtitle', { markdown: true }),
    freelancer: {
        title: t('services.freelancerVsAgency.freelancer.title'),
        points: [
            {
                icon: 'chat-bubble',
                title: t('services.freelancerVsAgency.freelancer.points.0.title'),
                description: t('services.freelancerVsAgency.freelancer.points.0.description')
            },
            {
                icon: 'bolt',
                title: t('services.freelancerVsAgency.freelancer.points.1.title'),
                description: t('services.freelancerVsAgency.freelancer.points.1.description')
            },
            {
                icon: 'currency-dollar',
                title: t('services.freelancerVsAgency.freelancer.points.2.title'),
                description: t('services.freelancerVsAgency.freelancer.points.2.description')
            },
            {
                icon: 'lightbulb',
                title: t('services.freelancerVsAgency.freelancer.points.3.title'),
                description: t('services.freelancerVsAgency.freelancer.points.3.description')
            }
        ]
    },
    agency: {
        title: t('services.freelancerVsAgency.agency.title'),
        points: [
            {
                icon: 'users',
                title: t('services.freelancerVsAgency.agency.points.0.title'),
                description: t('services.freelancerVsAgency.agency.points.0.description')
            },
            {
                icon: 'clock',
                title: t('services.freelancerVsAgency.agency.points.1.title'),
                description: t('services.freelancerVsAgency.agency.points.1.description')
            },
            {
                icon: 'building-office',
                title: t('services.freelancerVsAgency.agency.points.2.title'),
                description: t('services.freelancerVsAgency.agency.points.2.description')
            },
            {
                icon: 'document-text',
                title: t('services.freelancerVsAgency.agency.points.3.title'),
                description: t('services.freelancerVsAgency.agency.points.3.description')
            }
        ]
    },
    cta: { text: t('services.freelancerVsAgency.cta.text'), button: t('services.freelancerVsAgency.cta.button') }
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
    <section
        id="services"
        class="relative section services-section overflow-hidden pt-32 pb-24"
        style={`background-color: ${sectionsColors.services}`}
    >
        <AnimatedGradientBackground />

        <div class="container-custom relative z-10">
            <!-- Hero / Hub framing -->
            <SectionTitle
                title={t('servicesHub.title', { markdown: true })}
                subtitle={t('servicesHub.subtitle', { markdown: true })}
                size="2xl"
                customElement="h1"
            />

            <!-- Groupings: each section answers a visitor's actual outcome question -->
            <div class="mt-16 space-y-12">
                {
                    resolvedGroupings.map((grouping) => (
                        <article
                            class="rounded-2xl border border-foreground/10 bg-card/40 backdrop-blur-sm p-6 md:p-8"
                            data-grouping-id={grouping.id}
                        >
                            <header class="mb-6">
                                <h2 class="text-2xl md:text-3xl font-bold text-foreground mb-2">
                                    {grouping.headline}
                                </h2>
                                <p class="text-foreground-secondary text-base md:text-lg leading-relaxed max-w-3xl">
                                    {grouping.fit}
                                </p>
                            </header>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                {grouping.services.map((service) => {
                                    const copy = serviceBlurbs[service.id];
                                    return (
                                        <a
                                            href={`/${lang}/services/${service.slug}`}
                                            class="group flex items-start gap-4 p-5 rounded-xl border border-foreground/10 bg-background/40 hover:border-primary/40 hover:bg-background/60 transition-all duration-300"
                                            aria-label={copy.title}
                                        >
                                            <span class="flex-shrink-0 w-10 h-10 rounded-lg bg-primary/10 text-primary flex items-center justify-center group-hover:bg-primary group-hover:text-primary-foreground transition-colors duration-300">
                                                <ServiceIcon name={service.iconId} size={22} />
                                            </span>
                                            <div class="flex-1 min-w-0">
                                                <h3 class="text-base md:text-lg font-semibold text-foreground group-hover:text-primary transition-colors duration-300">
                                                    <span set:html={copy.title} />
                                                </h3>
                                                <p class="text-sm text-foreground-secondary leading-relaxed mt-1 line-clamp-3">
                                                    {copy.blurb}
                                                </p>
                                            </div>
                                            <svg
                                                class="flex-shrink-0 w-5 h-5 text-foreground-secondary group-hover:text-primary group-hover:translate-x-0.5 transition-all duration-300"
                                                fill="none"
                                                viewBox="0 0 24 24"
                                                stroke="currentColor"
                                                stroke-width="2"
                                                aria-hidden="true"
                                            >
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                                            </svg>
                                        </a>
                                    );
                                })}
                            </div>
                        </article>
                    ))
                }
            </div>

            <!-- Not-sure card — alternative to picking a grouping -->
            <aside class="mt-12 rounded-2xl border border-primary/20 bg-gradient-to-br from-primary/5 via-card/30 to-accent/5 p-6 md:p-8 text-center">
                <p class="text-xs font-medium uppercase tracking-widest text-primary mb-2">
                    {notSureTranslations.eyebrow}
                </p>
                <h2 class="text-2xl md:text-3xl font-bold text-foreground mb-3">
                    {notSureTranslations.title}
                </h2>
                <p class="text-foreground-secondary text-base leading-relaxed max-w-2xl mx-auto mb-6">
                    {notSureTranslations.body}
                </p>
                <UnifiedButton href={`/${lang}/contact`} variant="primary" size="md">
                    {notSureTranslations.cta}
                </UnifiedButton>
            </aside>

            <!-- Process Section - How I Work -->
            <ProcessSection translations={processTranslations} />

            <!-- Comparison Section -->
            <ComparisonSection lang={lang} translations={comparisonTranslations} />

            <!-- Freelancer vs Agency Section -->
            <FreelancerVsAgencySection lang={lang} translations={freelancerVsAgencyTranslations} />

            <!-- Call to Action Section -->
            <div class="text-center bg-foreground/5 backdrop-blur-sm rounded-2xl p-8 border border-foreground/10">
                <h2 class="text-2xl font-bold text-foreground mb-4" set:html={ctaTranslations.title} />
                <p class="text-foreground-secondary mb-6 max-w-2xl mx-auto" set:html={ctaTranslations.description} />

                <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
                    <UnifiedButton
                        href={`/${lang}/contact`}
                        variant="primary"
                        size="lg"
                        iconPosition="right"
                    >
                        <span set:html={ctaTranslations.button} />
                        <Fragment slot="icon-right">
                            <svg class="w-full h-full" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-3.582 8-8 8a8.959 8.959 0 01-4.906-1.478L3 21l2.478-5.094A8.959 8.959 0 013 12c0-4.418 3.582-8 8-8s8 3.582 8 8z" />
                            </svg>
                        </Fragment>
                    </UnifiedButton>

                    <div class="flex items-center text-foreground-secondary text-sm">
                        <svg class="w-4 h-4 mr-2 text-[rgb(var(--color-status-success))]" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                        </svg>
                        <span set:html={ctaTranslations.consultation} />
                    </div>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
