---
import { languages } from '@/i18n/ui';
import { getLangFromUrl, getTranslations } from '@/i18n/utils';
import BaseLayout from '@/layouts/BaseLayout.astro';

/**
 * Hire route — `/{lang}/hire`.
 *
 * Phase 1 shell only. The recruiter-oriented landing page will be authored in
 * Phase 4 (Requirement 9.1) with structured data for role fit, experience
 * highlights, stack, and resume access.
 *
 * Per Requirement 2.2, the shell exists in both `es` and `en`.
 */
export function getStaticPaths() {
    return Object.keys(languages).map((lang) => ({
        params: { lang }
    }));
}

const lang = getLangFromUrl(Astro.url);
const t = getTranslations(lang);

const pageTitle = `${t('hire.placeholder.title')} | ${t('hire.title')}`;
const pageDescription = t('hire.placeholder.subtitle');
---

<BaseLayout title={pageTitle} description={pageDescription}>
    <section class="container-custom py-24 md:py-32">
        <p class="text-xs font-medium uppercase tracking-widest text-primary">SPEC-001 · Phase 1 shell</p>
        <h1 class="mt-4 text-4xl font-bold text-foreground md:text-5xl">
            {t('hire.placeholder.title')}
        </h1>
        <p class="mt-4 max-w-2xl text-base text-foreground-secondary md:text-lg">
            {t('hire.placeholder.subtitle')}
        </p>
        <p class="mt-8 inline-flex items-center rounded-full border border-border bg-card/40 px-4 py-2 text-xs text-foreground-muted">
            {t('hire.placeholder.phase')}
        </p>
    </section>
</BaseLayout>
